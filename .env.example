# ==========================================
# Redwebs Agency - Production Environment Variables
# ==========================================

# Base URL
NEXT_PUBLIC_SITE_URL=https://redwebs.ir

# SMS Gateway (Kavenegar / FarazSMS)
SMS_API_KEY=
SMS_SENDER_NUMBER=

# Database Connection (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/redwebs_prod?sslmode=require

# Authentication Secrets
NEXTAUTH_SECRET=
NEXTAUTH_URL=https://redwebs.ir

# Payment Gateway (Zarinpal / Zibal / Direct PSP)
ZARINPAL_MERCHANT_ID=
PAYMENT_CALLBACK_URL=https://redwebs.ir/api/payment/callback

# Cloud Object Storage (S3 / ArvanCloud / Liara)
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_NAME=redwebs-assets
S3_REGION=default

# Telemetry & Error Tracking
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
